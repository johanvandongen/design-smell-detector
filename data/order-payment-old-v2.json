      {
        "data": {
          "id": "Order.calculateRefundableAmount(Payment)",
          "properties": {
            "visibility": "public",
            "simpleName": "calculateRefundableAmount(Payment)",
            "qualifiedName": "Order.calculateRefundableAmount(Payment)",
            "kind": "method",
            "sourceText": "// Calculates how much of a payment can still be refunded\r\npublic java.math.BigDecimal calculateRefundableAmount(Payment payment) {\r\n    if (!payment.isCaptured()) {\r\n        return java.math.BigDecimal.ZERO;\r\n    }\r\n    java.math.BigDecimal remainingPayment = payment.getCapturedAmount().subtract(payment.getRefundedAmount());\r\n    java.math.BigDecimal remainingOrderValue = this.total.subtract(payment.getRefundedAmount());\r\n    return remainingPayment.min(remainingOrderValue).max(java.math.BigDecimal.ZERO);\r\n}",
            "docComment": "",
            "metaSrc": "source code"
          },
          "labels": [
            "Operation"
          ]
        }
