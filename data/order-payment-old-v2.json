        "data": {
          "id": "Payment.refund(java.math.BigDecimal)",
          "properties": {
            "visibility": "public",
            "simpleName": "refund(java.math.BigDecimal)",
            "qualifiedName": "Payment.refund(java.math.BigDecimal)",
            "kind": "method",
            "sourceText": "public void refund(java.math.BigDecimal amount) {\r\n    java.math.BigDecimal refundable = this.order.calculateRefundableAmount(this);\r\n    if ((amount.compareTo(java.math.BigDecimal.ZERO) < 0) || (amount.compareTo(refundable) > 0)) {\r\n        throw new java.lang.IllegalArgumentException(\"Invalid refund amount\");\r\n    }\r\n    this.refundedAmount = this.refundedAmount.add(amount);\r\n}",
            "docComment": "",
            "metaSrc": "source code"
