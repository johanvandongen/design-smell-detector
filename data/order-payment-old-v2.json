      {
        "data": {
          "id": "Main.main(java.lang.String[])",
          "properties": {
            "visibility": "public",
            "simpleName": "main(java.lang.String[])",
            "qualifiedName": "Main.main(java.lang.String[])",
            "kind": "static method",
            "sourceText": "public static void main(java.lang.String[] args) {\r\n    Customer customer = new Customer();\r\n    Order order = new Order(new java.math.BigDecimal(\"100.00\"));\r\n    customer.addOrder(order);\r\n    Payment payment = new Payment(order, new java.math.BigDecimal(\"80.00\"));\r\n    payment.capture();\r\n    java.lang.System.out.println(\"=== Payment demonstration ===\");\r\n    java.lang.System.out.println(\"Order total: €\" + order.getTotal());\r\n    java.lang.System.out.println(\"Captured amount: €\" + payment.getCapturedAmount());\r\n    // Calculate refundable amount\r\n    java.math.BigDecimal refundable = order.calculateRefundableAmount(payment);\r\n    java.lang.System.out.println(\"Refundable amount: €\" + refundable);\r\n    // Refund €30\r\n    payment.refund(new java.math.BigDecimal(\"30.00\"));\r\n    java.lang.System.out.println(\"\\nAfter refunding €30:\");\r\n    java.lang.System.out.println(\"Already refunded: €\" + payment.getRefundedAmount());\r\n    refundable = order.calculateRefundableAmount(payment);\r\n    java.lang.System.out.println(\"Remaining refundable amount: €\" + refundable);\r\n    // Refund the remaining amount\r\n    payment.refund(refundable);\r\n    java.lang.System.out.println(\"\\nAfter refunding the remainder:\");\r\n    java.lang.System.out.println(\"Already refunded: €\" + payment.getRefundedAmount());\r\n    refundable = order.calculateRefundableAmount(payment);\r\n    java.lang.System.out.println(\"Remaining refundable amount: €\" + refundable);\r\n}",
            "docComment": "",
            "metaSrc": "source code"
          },
          "labels": [
            "Operation"
          ]
        }
